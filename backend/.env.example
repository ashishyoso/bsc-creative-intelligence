# Local storage paths (default to C: to avoid Google Drive sync)
VAULT_ROOT=C:/bsc-vault
DB_PATH=C:/bsc-vault/db/bsc.sqlite

# API keys (required for auto-tagging)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Models
VISION_MODEL=claude-sonnet-4-6
WHISPER_MODEL=whisper-1

# Pilot limits
MAX_INGEST_ROWS=100
DOWNLOAD_CONCURRENCY=8
DOWNLOAD_TIMEOUT_SECONDS=300
MAPPING_DURATION_TOLERANCE_SECONDS=2

# Tagging cost guardrails
PER_ASSET_TAGGING_BUDGET_INR=2.0
MONTHLY_TAGGING_BUDGET_INR=5000
