# Production env vars — paste these into Railway service variables.
# Do NOT commit a populated version of this file.

# === DB ===
# Supabase Postgres connection string (Settings → Database → URI)
DATABASE_URL=postgresql://postgres:CHANGE_ME@xxx.supabase.co:5432/postgres

# === Storage ===
# Where the persistent volume is mounted in the container
VAULT_ROOT=/app/vault

# === API keys (rotate from local dev keys — those are leaked) ===
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
OPENAI_API_KEY=sk-proj-CHANGE_ME

# === Auth ===
# Basic auth gate — anyone hitting the API must provide these creds
BASIC_AUTH_USER=yoso
BASIC_AUTH_PASS=CHANGE_ME_TO_A_REAL_PASSWORD

# === CORS ===
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=https://your-frontend.vercel.app

# === Models ===
VISION_MODEL=claude-sonnet-4-6
WHISPER_MODEL=whisper-1

# === Pipeline tuning ===
DOWNLOAD_CONCURRENCY=8
DOWNLOAD_TIMEOUT_SECONDS=300
MAPPING_DURATION_TOLERANCE_SECONDS=2

# === Cost guardrails (informational) ===
PER_ASSET_TAGGING_BUDGET_INR=2.0
MONTHLY_TAGGING_BUDGET_INR=5000
